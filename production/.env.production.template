# Domain Configuration
DOMAIN_NAME=library.deine-domain.de

# PostgreSQL Configuration
POSTGRES_USER=library_admin
POSTGRES_PASSWORD=generate_strong_password_here
AUTH_DB_NAME=auth_db
LIBRARY_DB_NAME=library_db

# JWT Configuration
JWT_SECRET_KEY=generate_256bit_secure_key_here
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Email Configuration (Echter SMTP für Production)
MAIL_HOST=smtp.dein-provider.com
MAIL_PORT=587
MAIL_USERNAME=deine-email@domain.com
MAIL_PASSWORD=dein-email-passwort

# GitHub Configuration für Images
GITHUB_REPOSITORY_OWNER=dein-github-username
